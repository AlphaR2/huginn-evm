# Copy to .env and fill in for your chain. Foundry scripts and the relayer read it.

# ---- Destination chain ----------------------------------------------------------------
# Local anvil: http://127.0.0.1:8545   Base Sepolia: https://sepolia.base.org
RPC_URL=http://127.0.0.1:8545
# Deployer / submitter key. Anvil's first default key works locally. Never commit a real one.
PRIVATE_KEY=

# SP1 verifier on this chain. Leave empty on anvil (chain 31337) to deploy the local
# stand-in instead. On Base / Base Sepolia use Succinct's SP1VerifierGateway for Groth16;
# take the address from github.com/succinctlabs/sp1-contracts (deployments/), and check it
# routes SP1 circuit version v6.1.0.
SP1_VERIFIER=

# ---- Solana side (from huginn) --------------------------------------------------------
# `huginn-evm-relayer vkey` prints it. Changes whenever the Huginn program changes.
PROGRAM_VKEY=0x000482e733e78ebf067e60f986f6ce40a167d0f233e82b3bdacc66f5d195fc1b
# Which Solana cluster: 28090 = the huginn local validator. (getClusterNodes -> shredVersion)
SHRED_VERSION=28090
SLOTS_PER_EPOCH=432000
# First epoch the client trusts, and its validator set hash (`fetch validator-set` prints
# the commitment). Local chain, epoch 0:
EPOCH=0
VALIDATOR_SET_HASH=0xb1f25236519c10b064498b6507ed0b87b88ad4df728a0a348e9434769d7d3c11

# ---- After deploying ------------------------------------------------------------------
# SolanaLightClient address printed by Deploy.s.sol.
HUGINN_CLIENT=
# The proof file the relayer wrote.
PROOF_FILE=proofs/proof.json
