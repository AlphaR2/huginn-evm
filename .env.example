# Copy to .env and fill in for your chain. Foundry scripts and the relayer read it.

# ---- Destination chain ----------------------------------------------------------------
# Local anvil: http://127.0.0.1:8545   Base Sepolia: https://sepolia.base.org
RPC_URL=http://127.0.0.1:8545
# Deployer / submitter key. Left empty, anvil's public test key is used, but only when the
# chain reports chain id 31337 (anvil). Any other chain needs a key here. Never commit a real one.
PRIVATE_KEY=

# SP1 verifier on this chain. Leave empty on anvil (chain 31337) to deploy the local
# stand-in instead. On Base / Base Sepolia use Succinct's SP1VerifierGateway for Groth16;
# take the address from github.com/succinctlabs/sp1-contracts (deployments/), and check it
# routes SP1 circuit version v6.1.0.
SP1_VERIFIER=
# Only on anvil with SP1_VERIFIER empty: `groth16` deploys SP1's real verifier (src/sp1) so
# real Groth16 proofs are checked locally; anything else deploys the stand-in. The app sets
# it for you in groth16 mode.
LOCAL_VERIFIER=

# ---- Solana side (from huginn) --------------------------------------------------------
# `huginn-evm vkey` prints it. Changes whenever the Huginn program changes.
PROGRAM_VKEY=0x00509a2b3b76ebc16e2ba8ef993e9d271ce0dd451697525e5d97d0ec5ffc98b0
# Which Solana cluster: 28090 = the huginn local validator. (getClusterNodes -> shredVersion)
SHRED_VERSION=28090
SLOTS_PER_EPOCH=432000
# First epoch the client trusts, and its validator set hash (`fetch validator-set` prints
# the commitment). Local chain, epoch 0:
EPOCH=0
VALIDATOR_SET_HASH=0xb1f25236519c10b064498b6507ed0b87b88ad4df728a0a348e9434769d7d3c11
# How long a newly proposed validator set waits before it counts, in seconds. During the
# wait anyone can see it and the owner can replace or cancel it. Unset: 0 on anvil, one day
# (86400) anywhere else. Keep it shorter than an epoch (~2 days on mainnet), or the next
# epoch's set can't be in place when the epoch starts.
# SET_DELAY=86400

# ---- After deploying ------------------------------------------------------------------
# SolanaLightClient address printed by Deploy.s.sol.
HUGINN_CLIENT=
# The proof file the relayer wrote.
PROOF_FILE=proofs/proof.json
