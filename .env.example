# Copy to .env and fill in for your chain. Foundry scripts and the app (huginn-evm) read it.

# ---- Destination chain ----------------------------------------------------------------
# Local anvil: http://127.0.0.1:8545   Base Sepolia: https://sepolia.base.org
# (devnet -> Base Sepolia: see docs/deploy.md)
RPC_URL=
# Deployer / submitter key. Left empty, anvil's public test key is used, but only when the
# chain reports chain id 31337 (anvil). Any other chain needs a key here. Never commit a real one.
PRIVATE_KEY=

# SP1 verifier on this chain. Leave empty on anvil (chain 31337) to deploy the local
# stand-in instead. On Base / Base Sepolia use Succinct's SP1VerifierGateway for Groth16;
# take the address from github.com/succinctlabs/sp1-contracts (deployments/), and check it
# routes SP1 circuit version v6.1.0.
SP1_VERIFIER=
# Only on anvil with SP1_VERIFIER empty: `groth16` deploys SP1's real verifier (src/sp1) so
# real Groth16 proofs are checked locally; anything else deploys the stand-in. The app sets
# it for you in groth16 mode.
LOCAL_VERIFIER=

# ---- Solana side ----------------------------------------------------------------------
# huginn-evm (the app) reads the shred version, epoch and validator set hash from the live
# chain when it deploys, and computes the program key, so it ignores the values below. They
# are only used if you run the forge scripts by hand.
# ---- (from huginn) --------------------------------------------------------
# `huginn-evm vkey` prints it. Changes whenever the Huginn program changes.
PROGRAM_VKEY=
# Which Solana cluster: 28090 = the huginn local validator. (getClusterNodes -> shredVersion)
SHRED_VERSION=
# Slots per Solana epoch. The app reads it from the cluster (`getEpochSchedule`) and ignores
# this; set it only for hand-run forge scripts. Mainnet and devnet: 432000.
SLOTS_PER_EPOCH=432000
# First epoch the client trusts, and its validator set hash (`fetch validator-set` prints
# the commitment). Local chain, epoch 0:
EPOCH=0
VALIDATOR_SET_HASH=
# How long a newly proposed validator set waits before it counts, in seconds. During the
# wait anyone can see it and the owner can replace or cancel it. Unset: 0 on anvil, two hours
# (7200) anywhere else. An epoch is 432,000 slots, about 25-29 hours (mainnet ~213 ms per
# slot, devnet ~240 ms). The app refuses a delay above 1/8 of the measured epoch, so a set
# proposed for epoch N during epoch N-1 is in force well before N starts.
# SET_DELAY=7200
# Proven handover (not built yet): the contract that checks evidence for each new epoch's set
# (src/sources/). Leave unset: the owner then proposes every set. With a source set, owner
# proposals become re-anchors (for a missed epoch) that wait REANCHOR_DELAY (default 7 days)
# and the guardian can cancel them.
# SET_SOURCE=
# REANCHOR_DELAY=604800

# ---- After deploying ------------------------------------------------------------------
# SolanaLightClient address printed by Deploy.s.sol.
HUGINN_CLIENT=
# The proof file the app wrote.
PROOF_FILE=

# ---- Solana RPC (used by the app and the huginn tools) -------------------------------------
# Optional. Defaults to the cluster's public endpoint. Provider URLs often carry an API key
# (https://...?api-key=...): the app shows only the host and passes the URL to child
# processes through the environment, never on a command line. Prefer exporting it in your
# shell instead of writing it in this file:
#   export SOLANA_RPC='https://...'
# SOLANA_RPC=
# Proving on Succinct's prover network: `export SP1_PROVER=network NETWORK_PRIVATE_KEY=...`
# in your shell (never in this file; the app does not pass it to anything but the prover).
